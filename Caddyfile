# FizioFit API gateway
:80 {
	# === PREFLIGHT (OPTIONS) — short-circuit, backend nezasahuje ===
	@preflight {
		method OPTIONS
	}
	handle @preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "apikey, authorization, content-type, x-client-info, x-supabase-api-version, x-sb-transport"
		header Access-Control-Max-Age "86400"
		respond 204
	}

	# === VŠETKY AKTUÁLNE REQUESTY ===
	# Odstráň backend CORS hlavičky (GoTrue, PostgREST si ich pridávajú samy)
	# a nahraď ich jedinou správnou sadou
	header {
		-Access-Control-Allow-Origin
		-Access-Control-Allow-Methods
		-Access-Control-Allow-Headers
		-Access-Control-Max-Age
		-Access-Control-Expose-Headers
		-Access-Control-Allow-Credentials
	}
	header Access-Control-Allow-Origin "*"
	header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
	header Access-Control-Allow-Headers "apikey, authorization, content-type, x-client-info, x-supabase-api-version, x-sb-transport"
	header Access-Control-Max-Age "86400"
	header Access-Control-Expose-Headers "X-Total-Count, Link, X-Supabase-Api-Version"

	# === PROXY ROUTES ===
	handle /auth/v1/* {
		uri strip_prefix /auth/v1
		reverse_proxy auth:9999
	}
	handle /rest/v1/* {
		uri strip_prefix /rest/v1
		reverse_proxy rest:3000
	}
	handle /storage/v1/* {
		uri strip_prefix /storage/v1
		reverse_proxy storage:5000
	}
	handle /realtime/v1/* {
		uri strip_prefix /realtime/v1
		reverse_proxy realtime:4000
	}
}