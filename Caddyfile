# FizioFit API gateway — zjednocuje Supabase služby pod jednu adresu
# Browser volá http://62.238.118.51:3004/auth/v1/... atd.
:80 {
	handle /auth/* {
		reverse_proxy auth:9999
	}
	handle /rest/* {
		reverse_proxy rest:3000
	}
	handle /storage/* {
		reverse_proxy storage:5000
	}
	handle /realtime/* {
		reverse_proxy realtime:4000
	}
}