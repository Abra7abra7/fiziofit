# FizioFit API gateway — CORS rieši každý backend samostatne
# Caddy len handle preflight (OPTIONS) aby short-circuitol
:80 {
	@preflight {
		method OPTIONS
	}
	handle @preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "apikey, authorization, content-type, x-client-info, x-supabase-api-version, x-sb-transport"
		header Access-Control-Max-Age "86400"
		respond 204
	}

	# Proxy routes — backendy (GoTrue, PostgREST) si CORS riešia samy
	handle /auth/v1/* {
		uri strip_prefix /auth/v1
		reverse_proxy auth:9999
	}
	handle /rest/v1/* {
		uri strip_prefix /rest/v1
		reverse_proxy rest:3000
	}
	handle /storage/v1/* {
		uri strip_prefix /storage/v1
		reverse_proxy storage:5000
	}
	handle /realtime/v1/* {
		uri strip_prefix /realtime/v1
		reverse_proxy realtime:4000
	}
}