# FizioFit API gateway — zjednocuje Supabase služby pod jednu adresu
# Browser volá http://62.238.118.51:3004/auth/v1/signup → auth:9999/signup
:80 {
	# CORS preflight — browser pýta pred POST/GET s apikey hlavičkou
	@preflight {
		method OPTIONS
	}
	header @preflight Access-Control-Allow-Origin "*"
	header @preflight Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
	header @preflight Access-Control-Allow-Headers "apikey, authorization, content-type, x-client-info, x-supabase-api-version, x-sb-transport"
	header @preflight Access-Control-Max-Age "86400"
	respond @preflight 204

	# CORS na všetky proxied odpovede
	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Allow-Headers "apikey, authorization, content-type, x-client-info, x-supabase-api-version, x-sb-transport"
		Access-Control-Max-Age 86400
	}

	handle /auth/v1/* {
		uri strip_prefix /auth/v1
		reverse_proxy auth:9999
	}
	handle /rest/v1/* {
		uri strip_prefix /rest/v1
		reverse_proxy rest:3000
	}
	handle /storage/v1/* {
		uri strip_prefix /storage/v1
		reverse_proxy storage:5000
	}
	handle /realtime/v1/* {
		uri strip_prefix /realtime/v1
		reverse_proxy realtime:4000
	}
}